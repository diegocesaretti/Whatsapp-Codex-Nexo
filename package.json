{
  "name": "whatsapp-codex-nexo",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Multi-input WhatsApp bridge with a single Codex-controlled output account",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "tray": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/nexo-tray.ps1",
    "open": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/nexo-open.ps1",
    "shortcut": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-shortcut.ps1",
    "desktop:dev": "pnpm build && npx --yes electron@43.4.1 .",
    "desktop:dir": "pnpm build && npx --yes electron-builder@26.15.3 --dir --publish never",
    "desktop:dist": "pnpm build && npx --yes electron-builder@26.15.3 --win nsis portable --x64 --publish never",
    "mcp": "tsx src/mcp.ts",
    "db:check": "tsx src/db-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "baileys": "7.0.0-rc13",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "ar.diegocesaretti.nexo",
    "productName": "Nexo",
    "electronVersion": "43.4.1",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/windows/nexo-tray.ps1",
        "to": "scripts/windows/nexo-tray.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexo"
    }
  }
}
